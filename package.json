{
  "name": "movie-harbor",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend/public-web",
    "frontend/admin-web",
    "frontend/packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "test:content-import": "node --test tests/content-import-*.test.mjs",
    "build:mcp": "npm run build --prefix mcp",
    "test:mcp": "npm test --prefix mcp",
    "import:content": "node tools/import-content.mjs",
    "convert:video": "node tools/convert-video.mjs",
    "test:video-conversion": "node --test tests/video-conversion-*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "package:offline": "sh tools/build-offline-package.sh"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "1.61.0"
  }
}
