APP_PORT=8080
DATABASE_HOST_DIR=./data/postgres
# Semicolon-separated, ordered media host directories. A single directory remains valid.
MEDIA_HOST_DIR=./data/media
POSTGRES_DB=movie_harbor
POSTGRES_USER=movie_harbor
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_NAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-admin-password
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
TRUST_PROXY_SECRET=replace-with-an-independent-long-random-proxy-secret
MAX_UPLOAD_BYTES=53687091200
VIDEO_MIME_ALLOWLIST=video/mp4,video/webm
